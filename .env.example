# Direct authless MCP configuration.

# Public base URL used by /healthz.
MCP_PUBLIC_BASE_URL=https://mcp.your-domain.example

# MCP endpoint:
# https://mcp.your-domain.example/

# Trusted hosts for FastMCP host-header validation.
# Include the exact public hostname(s) served by your reverse proxy.
MCP_TRUSTED_HOSTS=mcp.your-domain.example,localhost,127.0.0.1

# Set to 1 only if host validation still blocks requests behind proxy/CDN.
MCP_DISABLE_DNS_REBINDING_PROTECTION=0
