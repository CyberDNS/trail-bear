# TrailBear serves the web UI + REST API at / and one MCP endpoint at /mcp.
# No auth is done here — this is expected to run behind an MCP aggregator /
# reverse proxy that handles authentication.

# SQLite DB path (defaults to /data/trails.db in Docker, data/trails.db in dev).
TRAILS_DB_PATH=/data/trails.db

# HTTP port for the combined server.
PORT=8080
